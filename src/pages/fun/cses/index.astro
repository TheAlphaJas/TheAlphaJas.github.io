---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCSESEntries } from '../../../utils/content';

const entries = getCSESEntries();
const allTopics = Array.from(new Set(entries.flatMap(e => e.topics || (e.topic ? [e.topic] : [])))).sort();
---

<BaseLayout title="CSES Problem Set | Jasmer Singh Sanjotra" description="CSES Problem Set solutions and key insights.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/fun" class="text-muted hover:text-accent mb-6 inline-flex items-center space-x-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Fun Stuff</span>
    </a>
    
    <h1 class="page-title mb-4">CSES Problem Set</h1>
    
    <div class="prose max-w-none mb-8 pb-6 border-b border-divider">
      <p class="text-lg text-ink leading-relaxed mb-4">
        The CSES (Competitive Programmer's Handbook) Problem Set is a comprehensive collection of algorithmic 
        problems designed to help programmers master fundamental computer science concepts. This problem set 
        covers a wide range of topics including sorting, searching, dynamic programming, graph algorithms, 
        range queries, and more.
      </p>
      <p class="text-ink leading-relaxed mb-4">
        This section contains my C++ solutions to CSES problems. Each solution includes the complete 
        implementation with the key algorithmic approach. The problems are organized by topic, making it 
        easy to find solutions related to specific algorithmic techniques or data structures.
      </p>
      <p class="text-sm text-muted mb-4">
        All solutions are available on <a href="https://github.com/TheAlphaJas/cses-sols" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">GitHub</a>.
      </p>
      <div class="flex flex-wrap gap-3 mt-4">
        <a
          href="https://leetcode.com/jasmers"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3 py-1.5 text-sm border border-divider rounded-lg hover:border-accent transition-colors text-ink"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M16.102 17.93l-2.697 2.607c-.466.467-1.111.662-1.823.662s-1.357-.195-1.824-.662L2.102 13.607c-.467-.467-.702-1.15-.702-1.863s.235-1.357.702-1.824l4.389-4.39c.467-.467 1.15-.702 1.824-.702s1.357.235 1.823.702l.331.331c.195.195.512.195.707 0l2.414-2.414c.195-.195.512-.195.707 0l.331.331c.467.467 1.15.702 1.824.702s1.357-.235 1.823-.702l4.389-4.39c.467-.467 1.15-.702 1.824-.702s1.357.235 1.824.702l2.697 2.607c.467.467.702 1.15.702 1.824s-.235 1.357-.702 1.823l-4.389 4.39c-.467.467-1.15.702-1.824.702s-1.357-.235-1.823-.702l-.331-.331c-.195-.195-.512-.195-.707 0l-2.414 2.414c-.195.195-.512.195-.707 0l-.331-.331c-.467-.467-1.15-.702-1.824-.702s-1.357.235-1.823.702l-4.389 4.39c-.467.467-.702 1.15-.702 1.824s.235 1.357.702 1.823z"/>
          </svg>
          <span>LeetCode</span>
        </a>
        <a
          href="https://codeforces.com/profile/von_Braun"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3 py-1.5 text-sm border border-divider rounded-lg hover:border-accent transition-colors text-ink"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.5 7.5C5.328 7.5 6 8.172 6 9v10.5c0 .828-.672 1.5-1.5 1.5h-3C.672 21 0 20.328 0 19.5V9c0-.828.672-1.5 1.5-1.5h3zm9-4.5C14.328 3 15 3.672 15 4.5v15c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5v-15c0-.828.672-1.5 1.5-1.5h3zm9 7.5C23.328 10.5 24 11.172 24 12v7.5c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5V12c0-.828.672-1.5 1.5-1.5h3z"/>
          </svg>
          <span>Codeforces</span>
        </a>
      </div>
    </div>
    
    {entries.length > 0 ? (
      <>
        <!-- Search and Filter -->
        <div class="mb-8 space-y-4">
          <div class="relative">
            <input
              type="text"
              id="cses-search"
              placeholder="Search problems..."
              class="w-full px-4 py-2 pl-10 border border-divider rounded-lg bg-card text-ink focus:border-accent focus:outline-none transition-colors"
            />
            <svg class="w-5 h-5 absolute left-3 top-1/2 transform -translate-y-1/2 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          
          {allTopics.length > 0 && (
            <div class="flex flex-wrap gap-2">
              <button
                data-topic="all"
                class="topic-filter px-4 py-2 rounded-lg border border-divider bg-card text-ink hover:border-accent transition-colors active"
              >
                All Topics
              </button>
              {allTopics.map((topic) => (
                <button
                  data-topic={topic}
                  class="topic-filter px-4 py-2 rounded-lg border border-divider bg-card text-ink hover:border-accent transition-colors"
                >
                  {topic}
                </button>
              ))}
            </div>
          )}
        </div>
        
        <!-- Entries List -->
        <div class="space-y-4" id="entries-list">
          {entries.map((entry) => {
            const entryTopics = entry.topics || (entry.topic ? [entry.topic] : []);
            return (
              <a
                href={`/fun/cses/${entry.slug}`}
                class="cses-entry block p-6 border border-divider rounded-lg bg-card hover:border-accent transition-shadow duration-200 hover:shadow-md"
                data-topics={entryTopics.join(',')}
                data-name={entry.problemName.toLowerCase()}
              >
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2">
                      {entry.problemNumber && (
                        <span class="text-sm font-mono text-muted">
                          #{entry.problemNumber}
                        </span>
                      )}
                      <h2 class="text-xl font-semibold text-ink">
                        {entry.problemName}
                      </h2>
                    </div>
                    {entry.keyIdea && (
                      <p class="text-muted mb-3">{entry.keyIdea}</p>
                    )}
                    <div class="flex items-center gap-4 text-sm flex-wrap">
                      {entry.difficulty && (
                        <span class="px-2 py-1 bg-subtle text-ink rounded">
                          {entry.difficulty}
                        </span>
                      )}
                      {entryTopics.length > 0 && (
                        <span class="px-2 py-1 bg-subtle text-accent rounded">
                          {entryTopics[0]}
                        </span>
                      )}
                      {entry.language && (
                        <span class="text-muted">{entry.language}</span>
                      )}
                    </div>
                  </div>
                  <svg class="w-5 h-5 text-muted flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      </>
    ) : (
      <div class="p-6 border border-divider rounded-lg">
        <p class="text-muted mb-4">
          No CSES problems yet. Add problems to <code class="text-sm bg-subtle px-2 py-1 rounded">content/cses/</code>
        </p>
        <p class="text-sm text-muted">
          Create Markdown files with frontmatter similar to USACO entries.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('cses-search');
  const topicFilters = document.querySelectorAll('.topic-filter');
  const entries = document.querySelectorAll('.cses-entry');
  
  let currentTopic = 'all';
  let currentSearch = '';
  
  function filterEntries() {
    entries.forEach((entry) => {
      const topics = entry.getAttribute('data-topics') || '';
      const name = entry.getAttribute('data-name') || '';
      
      const matchesTopic = currentTopic === 'all' || topics.includes(currentTopic);
      const matchesSearch = currentSearch === '' || name.includes(currentSearch.toLowerCase());
      
      if (matchesTopic && matchesSearch) {
        entry.style.display = 'block';
      } else {
        entry.style.display = 'none';
      }
    });
  }
  
  // Search functionality
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = e.target.value.trim();
      filterEntries();
    });
  }
  
  // Topic filter functionality
  topicFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      currentTopic = filter.getAttribute('data-topic') || 'all';
      
      // Update active state
      topicFilters.forEach((f) => f.classList.remove('active'));
      filter.classList.add('active');
      
      filterEntries();
    });
  });
</script>

<style>
  .topic-filter.active {
    @apply border-accent font-semibold;
  }
</style>

