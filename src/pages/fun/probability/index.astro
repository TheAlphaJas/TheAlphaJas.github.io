---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProbabilityProblems } from '../../../utils/content';

const problems = getProbabilityProblems();
const allTopics = Array.from(new Set(problems.flatMap((p) => p.topics))).sort();
---

<BaseLayout
  title="Probability Corner | Jasmer Singh Sanjotra"
  description="Probability puzzles with detailed solutions."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/fun" class="text-sm text-muted hover:text-accent transition-colors inline-flex items-center gap-2 mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
      <span>back to fun</span>
    </a>

    <header class="page-header">
      <h1 class="page-title">Probability Corner</h1>
      <p class="page-subtitle">
        Puzzles I found worth keeping — Markov chains, information theory, stochastic processes — each with a
        worked solution.
      </p>
    </header>

    <!-- Filters -->
    <div class="mb-10 space-y-4">
      <input
        type="text"
        id="search-input"
        placeholder="Search problems..."
        class="w-full px-4 py-2 border border-divider rounded-md bg-card text-ink focus:border-accent focus:outline-none transition-colors"
      />

      <div class="flex flex-wrap gap-2">
        <button data-value="all" class="filter-btn active">All topics</button>
        {allTopics.map((topic) => <button data-value={topic} class="filter-btn">{topic}</button>)}
      </div>
    </div>

    <!-- Problems -->
    <div class="space-y-3" id="problems-list">
      {
        problems.map((problem) => (
          <a
            href={`/fun/probability/${problem.slug}`}
            class="problem-card card block p-5"
            data-topics={problem.topics.join(',')}
            data-title={problem.title.toLowerCase()}
          >
            <h2 class="font-serif text-lg text-ink">{problem.title}</h2>
            {problem.topics.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {problem.topics.map((topic) => (
                  <span class="pill">{topic}</span>
                ))}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const problemCards = document.querySelectorAll<HTMLElement>('.problem-card');

  let activeTopic = 'all';
  let activeSearch = '';

  function filterProblems() {
    problemCards.forEach((card) => {
      const topics = card.getAttribute('data-topics')?.split(',') || [];
      const title = card.getAttribute('data-title') || '';

      const matchesTopic = activeTopic === 'all' || topics.includes(activeTopic);
      const matchesSearch = activeSearch === '' || title.includes(activeSearch.toLowerCase());

      card.style.display = matchesTopic && matchesSearch ? 'block' : 'none';
    });
  }

  searchInput?.addEventListener('input', (e) => {
    activeSearch = (e.target as HTMLInputElement).value.trim();
    filterProblems();
  });

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeTopic = btn.getAttribute('data-value') || 'all';
      filterProblems();
    });
  });
</script>

<style>
  .filter-btn {
    @apply px-3 py-1 text-sm rounded border border-divider text-muted transition-colors;
  }

  .filter-btn:hover {
    @apply text-accent;
    border-color: var(--global-theme-color);
  }

  .filter-btn.active {
    @apply text-accent font-medium;
    border-color: var(--global-theme-color);
  }
</style>
