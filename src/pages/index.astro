---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Jasmer's Corner | Home" description="Research engineer and competitive programmer specializing in ML, RL, signal processing, and systems.">
  <!-- Decorative background elements -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-blue-300/20 dark:bg-blue-500/10 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-indigo-300/20 dark:bg-indigo-500/10 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-1/4 left-1/3 w-96 h-96 bg-purple-300/20 dark:bg-purple-500/10 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 2s;"></div>
  </div>
  
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
    <div class="space-y-8">
      <!-- Header -->
      <div class="relative">
        <!-- Decorative corner elements -->
        <div class="absolute -top-4 -left-4 w-24 h-24 border-t-4 border-l-4 border-blue-300 dark:border-blue-600 rounded-tl-lg opacity-50"></div>
        <div class="absolute -bottom-4 -right-4 w-24 h-24 border-b-4 border-r-4 border-purple-300 dark:border-purple-600 rounded-br-lg opacity-50"></div>
        <div class="space-y-2 text-center">
          <h1 id="typing-name" class="text-4xl sm:text-5xl font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent leading-tight pb-2" style="line-height: 1.2; padding-bottom: 0.5rem;">
            Jasmer Singh Sanjotra
          </h1>
        </div>
      </div>
      
      <!-- Introduction -->
      <div class="prose prose-slate dark:prose-invert max-w-none pt-4">
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
          Welcome to my corner of the internet. I'm Jasmer — a learner, builder, and researcher in training. 
          I like working at the intersection of engineering, machine learning, and mathematics, and I'm gradually 
          finding my way deeper into research through projects, experiments, and a lot of trial and error. This 
          space is where I document that process — the things I'm building, the ideas I'm exploring. You can 
          find a glimpse of what I've tried to do so far here. I'm generally focused more on the "fundamentals", 
          trying to learn and understand under-the-hood ops, but at the same time can use the black-box treatment 
          when necessary.
        </p>
      </div>
      
      <!-- Site Structure Explanation -->
      <div class="prose prose-slate dark:prose-invert max-w-none pt-6 border-t-2 relative" style="border-image: linear-gradient(to right, rgb(191 219 254), rgb(199 210 254), rgb(221 214 254)) 1; border-image-slice: 1; border-color: rgb(191 219 254);">
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
          <div class="w-6 h-6 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full border-4 border-white dark:border-slate-900"></div>
        </div>
        <h2 class="text-2xl font-semibold mb-4 bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400 bg-clip-text text-transparent relative inline-block">
          <span class="absolute -left-8 top-1/2 transform -translate-y-1/2 text-2xl opacity-50">✦</span>
          About This Site
          <span class="absolute -right-8 top-1/2 transform -translate-y-1/2 text-2xl opacity-50">✦</span>
        </h2>
        <p class="text-slate-700 dark:text-slate-300 leading-relaxed mb-4">
          This website serves as both a portfolio and a knowledge repository. Here's what you'll find:
        </p>
        <ul class="list-none space-y-3 text-slate-700 dark:text-slate-300 mb-6 pl-0">
          <li class="flex items-start gap-3 group">
            <span class="flex-shrink-0 w-2 h-2 rounded-full bg-blue-500 mt-2 group-hover:scale-150 transition-transform duration-300"></span>
            <span><strong class="text-slate-700 dark:text-slate-300">Projects:</strong> Research and engineering projects spanning machine learning, deep learning, signal processing, and systems engineering</span>
          </li>
          <li class="flex items-start gap-3 group">
            <span class="flex-shrink-0 w-2 h-2 rounded-full bg-indigo-500 mt-2 group-hover:scale-150 transition-transform duration-300"></span>
            <span><strong class="text-slate-700 dark:text-slate-300">Experience:</strong> Professional timeline including internships, research positions, and teaching roles</span>
          </li>
          <li class="flex items-start gap-3 group">
            <span class="flex-shrink-0 w-2 h-2 rounded-full bg-purple-500 mt-2 group-hover:scale-150 transition-transform duration-300"></span>
            <span><strong class="text-slate-700 dark:text-slate-300">Publications:</strong> Research papers published in conferences and journals</span>
          </li>
          <li class="flex items-start gap-3 group">
            <span class="flex-shrink-0 w-2 h-2 rounded-full bg-blue-500 mt-2 group-hover:scale-150 transition-transform duration-300"></span>
            <span><strong class="text-slate-700 dark:text-slate-300">Probability Corner:</strong> A collection of interesting probability puzzles and their solutions</span>
          </li>
          <li class="flex items-start gap-3 group">
            <span class="flex-shrink-0 w-2 h-2 rounded-full bg-indigo-500 mt-2 group-hover:scale-150 transition-transform duration-300"></span>
            <span><strong class="text-slate-700 dark:text-slate-300">Aviation Corner:</strong> Documentation of airlines flown, aircraft types, and aviation interests</span>
          </li>
        </ul>
      </div>
      
      <!-- Quick Links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 relative">
        <a
          href="/projects"
          class="p-4 border-2 border-blue-200 dark:border-indigo-700 rounded-lg bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-900 hover:border-blue-400 dark:hover:border-indigo-500 hover:shadow-lg transition-all duration-300 transform hover:scale-105"
        >
          <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-2">Projects</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">Research and engineering projects</p>
        </a>
        <a
          href="/experience"
          class="p-4 border-2 border-indigo-200 dark:border-purple-700 rounded-lg bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-slate-800 dark:to-slate-900 hover:border-indigo-400 dark:hover:border-purple-500 hover:shadow-lg transition-all duration-300 transform hover:scale-105"
        >
          <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-2">Experience</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">Professional timeline</p>
        </a>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script>
  // Typing animation for name
  (function() {
    const nameElement = document.getElementById('typing-name');
    if (!nameElement) return;
    
    const fullName = 'Jasmer Singh Sanjotra';
    let currentIndex = 0;
    
    function typeName() {
      if (currentIndex < fullName.length) {
        nameElement.textContent = fullName.substring(0, currentIndex + 1);
        currentIndex++;
        setTimeout(typeName, 100);
      } else {
        // Remove typing cursor after completion
        setTimeout(() => {
          nameElement.style.borderRight = 'none';
        }, 500);
      }
    }
    
    // Start typing animation after a short delay
    setTimeout(typeName, 500);
  })();
</script>
