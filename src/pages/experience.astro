---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperiences } from '../utils/content';

const experiences = getExperiences();
---

<BaseLayout title="Experience | Jasmer's Corner" description="Professional experience in research, engineering, and systems.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold mb-8 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">Experience</h1>
    
    <div class="space-y-12">
      {experiences.map((exp, index) => (
        <div class="relative pl-8 border-l-2 border-blue-300 dark:border-indigo-600">
          {index < experiences.length - 1 && (
            <div class="absolute -left-1.5 top-12 w-3 h-3 bg-gradient-to-r from-blue-500 to-indigo-500 dark:from-blue-400 dark:to-indigo-400 rounded-full border-2 border-white dark:border-slate-900"></div>
          )}
          
          <div class="space-y-4 p-6 border-2 border-blue-200 dark:border-indigo-700 rounded-lg bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-900 hover:border-blue-400 dark:hover:border-indigo-500 hover:shadow-lg transition-all duration-300">
            <div>
              <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">
                {exp.role}
              </h2>
              <p class="text-lg text-slate-600 dark:text-slate-400">
                {exp.organization}
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-500">
                {exp.duration} • {exp.domain}
              </p>
            </div>
            
            {exp.achievements.length > 0 && (
              <ul class="list-disc list-inside space-y-2 text-slate-700 dark:text-slate-300">
                {exp.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            )}
            
            {exp.techStack.length > 0 && (
              <div>
                <p class="text-sm font-semibold text-slate-600 dark:text-slate-400 mb-2">Tech Stack:</p>
                <div class="flex flex-wrap gap-2">
                  {exp.techStack.map((tech) => (
                    <span class="px-2 py-1 text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded font-mono">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

