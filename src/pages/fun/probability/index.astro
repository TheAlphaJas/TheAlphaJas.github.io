---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProbabilityProblems } from '../../../utils/content';

const problems = getProbabilityProblems();
const allTopics = Array.from(new Set(problems.flatMap((p) => p.topics))).sort();
const difficulties = ['Easy', 'Medium', 'Hard'];
---

<BaseLayout title="Probability Corner | Jasmer's Corner" description="Mathematical probability problems with detailed solutions.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/fun" class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 mb-6 inline-flex items-center space-x-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Fun Stuff</span>
    </a>
    
    <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">Probability Corner</h1>
    
    <div class="prose prose-slate dark:prose-invert max-w-none mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
      <p class="text-slate-700 dark:text-slate-300">
        A collection of probability puzzles and problems that I find intriguing. These range from 
        classic problems to more challenging puzzles involving Markov chains, information theory, 
        and stochastic processes. Each problem includes a detailed solution with the key insights 
        and mathematical reasoning.
      </p>
    </div>
    
    <!-- Filters -->
    <div class="mb-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Search</label>
        <input
          type="text"
          id="search-input"
          placeholder="Search problems..."
          class="w-full px-4 py-2 border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100"
        />
      </div>
      
      <div class="flex flex-wrap gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Difficulty</label>
          <div class="flex flex-wrap gap-2">
            <button
              data-filter="difficulty"
              data-value="all"
              class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors active"
            >
              All
            </button>
            {difficulties.map((diff) => (
              <button
                data-filter="difficulty"
                data-value={diff}
                class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors"
              >
                {diff}
              </button>
            ))}
          </div>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Topic</label>
          <div class="flex flex-wrap gap-2">
            <button
              data-filter="topic"
              data-value="all"
              class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors active"
            >
              All
            </button>
            {allTopics.map((topic) => (
              <button
                data-filter="topic"
                data-value={topic}
                class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors"
              >
                {topic}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
    
    <!-- Problems List -->
    <div class="space-y-4" id="problems-list">
      {problems.map((problem) => (
        <a
          href={`/fun/probability/${problem.slug}`}
          class="problem-card block p-6 border-2 border-blue-200 dark:border-indigo-700 rounded-lg bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-900 hover:border-blue-400 dark:hover:border-indigo-500 hover:shadow-lg transition-all duration-300 transform hover:scale-105"
          data-difficulty={problem.difficulty}
          data-topics={problem.topics.join(',')}
          data-title={problem.title.toLowerCase()}
        >
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">
              {problem.title}
            </h2>
            <span class="px-3 py-1 text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded">
              {problem.difficulty}
            </span>
          </div>
          <div class="flex flex-wrap gap-2 mt-3">
            {problem.topics.map((topic) => (
              <span class="px-2 py-1 text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 rounded">
                {topic}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input');
  const filterButtons = document.querySelectorAll('.filter-btn');
  const problemCards = document.querySelectorAll('.problem-card');
  
  let activeFilters = {
    difficulty: 'all',
    topic: 'all',
    search: '',
  };
  
  function filterProblems() {
    problemCards.forEach((card) => {
      const difficulty = card.getAttribute('data-difficulty');
      const topics = card.getAttribute('data-topics')?.split(',') || [];
      const title = card.getAttribute('data-title') || '';
      
      const matchesDifficulty = activeFilters.difficulty === 'all' || difficulty === activeFilters.difficulty;
      const matchesTopic = activeFilters.topic === 'all' || topics.includes(activeFilters.topic);
      const matchesSearch = activeFilters.search === '' || title.includes(activeFilters.search.toLowerCase());
      
      if (matchesDifficulty && matchesTopic && matchesSearch) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
  
  searchInput?.addEventListener('input', (e) => {
    activeFilters.search = (e.target as HTMLInputElement).value;
    filterProblems();
  });
  
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterType = btn.getAttribute('data-filter');
      const value = btn.getAttribute('data-value');
      
      if (filterType && value) {
        // Update active state
        filterButtons.forEach((b) => {
          if (b.getAttribute('data-filter') === filterType) {
            b.classList.remove('active', 'border-slate-900', 'dark:border-slate-100');
          }
        });
        btn.classList.add('active', 'border-slate-900', 'dark:border-slate-100');
        
        activeFilters[filterType as keyof typeof activeFilters] = value;
        filterProblems();
      }
    });
  });
</script>

<style>
  .filter-btn.active {
    @apply border-slate-900 dark:border-slate-100 font-semibold;
  }
</style>

