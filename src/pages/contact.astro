---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const entries = [
  { label: 'Email', value: 'jasmer.sanjotra@gmail.com', href: 'mailto:jasmer.sanjotra@gmail.com' },
  { label: 'Email (alt)', value: 'jasmer.sanjotra@proton.me', href: 'mailto:jasmer.sanjotra@proton.me' },
  { label: 'Phone', value: '+91 87884 65639', href: 'tel:+918788465639' },
  { label: 'GitHub', value: 'TheAlphaJas', href: 'https://github.com/TheAlphaJas' },
  {
    label: 'Google Scholar',
    value: 'Jasmer Singh Sanjotra',
    href: 'https://scholar.google.com/citations?hl=en&user=NUCuUbIAAAAJ',
  },
  {
    label: 'LinkedIn',
    value: 'jasmer-singh-sanjotra',
    href: 'https://www.linkedin.com/in/jasmer-singh-sanjotra-a05b95250',
  },
  { label: 'Codeforces', value: 'von_Braun', href: 'https://codeforces.com/profile/von_Braun' },
  { label: 'LeetCode', value: 'jasmers', href: 'https://leetcode.com/jasmers' },
];
---

<BaseLayout title="Contact | Jasmer Singh Sanjotra" description="Get in touch by email, GitHub, or LinkedIn.">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="page-header">
      <h1 class="page-title">Contact</h1>
      <p class="page-subtitle">
        Happy to talk about research, collaborations, or a problem you cannot stop thinking about. Email is
        the surest way to reach me.
      </p>
    </header>

    <dl class="space-y-4">
      {
        entries.map((entry) => (
          <div class="sm:flex sm:gap-6">
            <dt class="text-sm text-muted sm:w-40 sm:flex-none sm:pt-0.5">{entry.label}</dt>
            <dd>
              <a
                href={entry.href}
                target={entry.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener noreferrer"
                class="link"
              >
                {entry.value}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>

    <SocialLinks class="mt-12 pt-8 border-t border-divider" />
  </div>
</BaseLayout>
