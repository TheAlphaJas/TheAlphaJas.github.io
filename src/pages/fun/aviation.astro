---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfiniteFlightStats from '../../components/InfiniteFlightStats.astro';
import fs from 'fs';
import path from 'path';

const airlinesPath = path.join(process.cwd(), 'content', 'aviation', 'airlines.json');
const airlines = fs.existsSync(airlinesPath) 
  ? JSON.parse(fs.readFileSync(airlinesPath, 'utf-8'))
  : [];
---

<BaseLayout title="Aviation Corner | Jasmer Singh Sanjotra" description="Airlines flown, aircraft types, and Infinite Flight stats.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/fun" class="text-muted hover:text-accent mb-6 inline-flex items-center space-x-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Fun Stuff</span>
    </a>
    
    <h1 class="page-title mb-4">Aviation Corner</h1>
    
    <div class="prose max-w-none mb-12 pb-6 border-b border-divider">
      <p class="text-ink">
        As an aviation enthusiast, I track the airlines I've flown, the aircraft types I've experienced, 
        and maintain my Infinite Flight statistics. This section documents my journey through the skies, 
        from commercial flights to virtual aviation experiences. Each airline entry includes the aircraft 
        types flown, providing a detailed record of my aviation adventures.
      </p>
    </div>
    
    <!-- Airlines Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Airlines Flown</h2>
      {airlines.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {airlines.map((airline: any) => {
            // Card body is identical whether or not the airline links out.
            const Tag = airline.website ? 'a' : 'div';
            const linkAttrs = airline.website
              ? { href: airline.website, target: '_blank', rel: 'noopener noreferrer' }
              : {};
            return (
              <div class="card overflow-hidden">
                <Tag {...linkAttrs} class="block p-5">
                  <div class="logo-plate h-28 mb-4">
                    {airline.logo ? (
                      <img
                        src={airline.logo}
                        alt={airline.name}
                        class="max-w-full max-h-full object-contain"
                        loading="lazy"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                    ) : null}
                    <div
                      class="w-full h-full items-center justify-center"
                      style={airline.logo ? 'display: none;' : 'display: flex;'}
                    >
                      <span class="font-serif text-4xl text-[#8a8a8a]">{airline.name.charAt(0)}</span>
                    </div>
                  </div>
                  {airline.equipment && airline.equipment.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 justify-center">
                      {airline.equipment.map((aircraft: string) => (
                        <span class="pill">{aircraft}</span>
                      ))}
                    </div>
                  )}
                </Tag>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="text-muted">No airlines data available. Add airlines to <code class="text-sm bg-subtle px-2 py-1 rounded">content/aviation/airlines.json</code></p>
      )}
    </section>
    
    <!-- Infinite Flight Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Infinite Flight</h2>
      <InfiniteFlightStats />
    </section>
  </div>
</BaseLayout>
