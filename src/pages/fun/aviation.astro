---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfiniteFlightStats from '../../components/InfiniteFlightStats.astro';
import fs from 'fs';
import path from 'path';

const airlinesPath = path.join(process.cwd(), 'content', 'aviation', 'airlines.json');
const airlines = fs.existsSync(airlinesPath)
  ? JSON.parse(fs.readFileSync(airlinesPath, 'utf-8'))
  : [];

const airportsPath = path.join(process.cwd(), 'content', 'aviation', 'airports.json');
const allAirports = fs.existsSync(airportsPath)
  ? JSON.parse(fs.readFileSync(airportsPath, 'utf-8'))
  : [];

// Only airports carrying coordinates can be plotted; the rest are skipped rather
// than silently dropped onto (0, 0).
const airports = allAirports.filter(
  (a: any) => typeof a.lat === 'number' && typeof a.lon === 'number'
);
---

<BaseLayout title="Aviation Corner | Jasmer Singh Sanjotra" description="Airlines flown, aircraft types, and Infinite Flight stats.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/fun" class="text-muted hover:text-accent mb-6 inline-flex items-center space-x-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Fun Stuff</span>
    </a>
    
    <header class="page-header">
      <h1 class="page-title">Aviation Corner</h1>
      <p class="page-subtitle">
        I like planes! And I like airlines even more. Here's everyone I've flown with, what they put me on,
        and a few Infinite Flight numbers nobody asked for.
      </p>
    </header>
    
    <!-- Airlines Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Airlines Flown</h2>
      {airlines.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {airlines.map((airline: any) => {
            // Card body is identical whether or not the airline links out.
            const Tag = airline.website ? 'a' : 'div';
            const linkAttrs = airline.website
              ? { href: airline.website, target: '_blank', rel: 'noopener noreferrer' }
              : {};
            return (
              <div class="card overflow-hidden">
                <Tag {...linkAttrs} class="block p-5">
                  <div class="logo-plate h-28 mb-4">
                    {airline.logo ? (
                      <img
                        src={airline.logo}
                        alt={airline.name}
                        class="max-w-full max-h-full object-contain"
                        loading="lazy"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                    ) : null}
                    <div
                      class="w-full h-full items-center justify-center"
                      style={airline.logo ? 'display: none;' : 'display: flex;'}
                    >
                      <span class="font-serif text-4xl text-[#8a8a8a]">{airline.name.charAt(0)}</span>
                    </div>
                  </div>
                  {airline.equipment && airline.equipment.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 justify-center">
                      {airline.equipment.map((aircraft: string) => (
                        <span class="pill">{aircraft}</span>
                      ))}
                    </div>
                  )}
                </Tag>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="text-muted">No airlines data available. Add airlines to <code class="text-sm bg-subtle px-2 py-1 rounded">content/aviation/airlines.json</code></p>
      )}
    </section>
    
    <!-- Airports Map Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Airports</h2>
      {airports.length > 0 ? (
        <>
          <div
            id="airport-map"
            class="h-[24rem] sm:h-[30rem] w-full border border-divider"
            role="region"
            aria-label={`Map of ${airports.length} airports`}
          />
          <p class="mt-3 text-sm text-muted">
            {airports.length} airport{airports.length === 1 ? '' : 's'}. Click a marker for details; use the
            +/&minus; controls to zoom.
          </p>
          <script type="application/json" id="airport-data" set:html={JSON.stringify(airports)} />
        </>
      ) : (
        <p class="text-muted">
          No airports with coordinates yet. Add entries with <code class="text-sm bg-subtle px-2 py-1 rounded">lat</code>
          and <code class="text-sm bg-subtle px-2 py-1 rounded">lon</code> to
          <code class="text-sm bg-subtle px-2 py-1 rounded">content/aviation/airports.json</code>
        </p>
      )}
    </section>

    <!-- Infinite Flight Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Infinite Flight</h2>
      <InfiniteFlightStats />
    </section>
  </div>
</BaseLayout>

<script>
  // Leaflet is bundled from node_modules rather than a CDN, so the only external
  // request the map makes is for the tiles themselves.
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const container = document.getElementById('airport-map');
  const dataEl = document.getElementById('airport-data');

  if (container && dataEl) {
    interface Airport {
      code: string;
      name: string;
      city: string;
      country: string;
      lat: number;
      lon: number;
    }

    const airports: Airport[] = JSON.parse(dataEl.textContent || '[]');

    const escapeHtml = (value: string) =>
      String(value ?? '').replace(/[&<>"']/g, (c) => {
        const map: Record<string, string> = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };
        return map[c];
      });

    // scrollWheelZoom stays off so the map never hijacks page scrolling.
    const map = L.map(container, { scrollWheelZoom: false, worldCopyJump: true });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 18,
    }).addTo(map);

    // The site's accent colour, so the markers follow the theme.
    const accent =
      getComputedStyle(document.documentElement).getPropertyValue('--global-theme-color').trim() || '#b509ac';

    // circleMarker rather than the default pin: Leaflet's default icon points at
    // image files by relative URL, which do not survive bundling.
    const markers = airports.map((airport) =>
      L.circleMarker([airport.lat, airport.lon], {
        radius: 6,
        color: accent,
        weight: 2,
        fillColor: accent,
        fillOpacity: 0.55,
      }).bindPopup(
        `<strong>${escapeHtml(airport.code)}</strong> — ${escapeHtml(airport.name)}<br />` +
          `${escapeHtml(airport.city)}, ${escapeHtml(airport.country)}`
      )
    );

    markers.forEach((marker) => marker.addTo(map));

    if (markers.length > 0) {
      // maxZoom keeps a single marker from zooming all the way to street level.
      map.fitBounds(L.featureGroup(markers).getBounds().pad(0.2), { maxZoom: 6 });
    } else {
      map.setView([20, 0], 2);
    }
  }
</script>

