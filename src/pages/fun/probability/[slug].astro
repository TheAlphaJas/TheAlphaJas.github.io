---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProbabilityProblems } from '../../../utils/content';
import { renderMarkdown } from '../../../utils/markdown';

export async function getStaticPaths() {
  const problems = getProbabilityProblems();
  return problems.map((problem) => ({
    params: { slug: problem.slug },
    props: { problem },
  }));
}

const { problem } = Astro.props;
const problemHtml = await renderMarkdown(problem.problem);
const solutionHtml = await renderMarkdown(problem.solution);
---

<BaseLayout title={`${problem.title} | Probability Corner`} description={`Probability problem: ${problem.title}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center gap-4 mb-6">
      <a href="/fun" class="text-muted hover:text-accent inline-flex items-center space-x-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Fun Stuff</span>
      </a>
      <span class="text-muted">/</span>
      <a href="/fun/probability" class="text-muted hover:text-accent">
        Probability Corner
      </a>
    </div>
    
    <article class="prose max-w-none">
      <h1 class="font-serif text-3xl font-medium text-ink mb-4">{problem.title}</h1>

      <div class="flex flex-wrap gap-1.5 mb-8">
        {problem.topics.map((topic) => (
          <span class="pill">{topic}</span>
        ))}
      </div>
      
      <div class="border-t border-divider pt-8 mb-8">
        <h2 class="text-2xl font-semibold mb-4">Problem</h2>
        <div set:html={problemHtml} />
      </div>
      
      <div class="border-t border-divider pt-8">
        <h2 class="text-2xl font-semibold mb-4">Solution</h2>
        <div set:html={solutionHtml} />
      </div>
    </article>
  </div>
</BaseLayout>

