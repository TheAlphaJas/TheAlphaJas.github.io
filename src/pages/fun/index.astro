---
import BaseLayout from '../../layouts/BaseLayout.astro';

const corners = [
  {
    href: '/fun/probability',
    title: 'Probability Corner',
    description: 'Puzzles that break intuition, with worked solutions.',
  },
  {
    href: '/fun/cses',
    title: 'CSES Problem Set',
    description: 'C++ solutions and the key idea behind each one.',
  },
  {
    href: '/fun/usaco',
    title: 'USACO',
    description: 'Contest problems, algorithms, and data structures.',
  },
  {
    href: '/fun/aviation',
    title: 'Aviation Corner',
    description: 'Airlines flown, aircraft types, and Infinite Flight stats.',
  },
];
---

<BaseLayout
  title="Fun | Jasmer Singh Sanjotra"
  description="Probability puzzles, competitive programming solutions, and aviation."
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="page-header">
      <h1 class="page-title">Fun</h1>
      <p class="page-subtitle">Things I keep around because I enjoy them, not because they are useful.</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {
        corners.map((corner) => (
          <a href={corner.href} class="card block p-5">
            <h2 class="font-serif text-lg text-ink mb-1.5">{corner.title}</h2>
            <p class="text-sm text-muted">{corner.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
