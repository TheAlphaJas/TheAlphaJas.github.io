---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../utils/content';

const projects = getProjects();
const allTags = Array.from(new Set(projects.flatMap((p) => p.tags))).sort();
---

<BaseLayout title="Projects | Jasmer's Corner" description="Research and engineering projects in ML, systems, and signal processing.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold mb-4">Projects</h1>
    
    <div class="prose prose-slate dark:prose-invert max-w-none mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
      <p class="text-slate-700 dark:text-slate-300">
        A collection of research and engineering projects spanning machine learning, reinforcement learning, 
        signal processing, and systems engineering. Each project includes objectives, key ideas, technical 
        stack, and results. Projects are tagged by domain for easy filtering.
      </p>
    </div>
    
    <!-- Tag Filter -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2" id="tag-filters">
        <button
          data-tag="all"
          class="tag-filter px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors active"
        >
          All
        </button>
        {allTags.map((tag) => (
          <button
            data-tag={tag}
            class="tag-filter px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors"
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
    
    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
      {projects.map((project) => (
        <a
          href={`/projects/${project.slug}`}
          class="project-card block p-6 border-2 border-slate-200 dark:border-slate-800 rounded-lg hover:border-slate-400 dark:hover:border-slate-600 transition-colors"
          data-tags={project.tags.join(',')}
        >
          <h2 class="text-xl font-semibold mb-2 text-slate-900 dark:text-slate-100">
            {project.title}
          </h2>
          <p class="text-slate-600 dark:text-slate-400 mb-4">
            {project.objective}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            {project.tags.map((tag) => (
              <span class="px-2 py-1 text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex items-center space-x-4 text-sm text-slate-500 dark:text-slate-500">
            {project.github && (
              <span class="flex items-center space-x-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                <span>GitHub</span>
              </span>
            )}
            {project.paper && (
              <span class="flex items-center space-x-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Paper</span>
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const tagFilters = document.querySelectorAll('.tag-filter');
  const projectCards = document.querySelectorAll('.project-card');
  
  tagFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const selectedTag = filter.getAttribute('data-tag');
      
      // Update active state
      tagFilters.forEach((f) => f.classList.remove('active', 'border-slate-900', 'dark:border-slate-100'));
      filter.classList.add('active', 'border-slate-900', 'dark:border-slate-100');
      
      // Filter projects
      projectCards.forEach((card) => {
        const tags = card.getAttribute('data-tags')?.split(',') || [];
        if (selectedTag === 'all' || tags.includes(selectedTag)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .tag-filter.active {
    @apply border-slate-900 dark:border-slate-100 font-semibold;
  }
</style>

