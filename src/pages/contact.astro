---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Jasmer's Corner" description="Get in touch via email, GitHub, or LinkedIn.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">Contact</h1>
    
    <div class="prose prose-slate dark:prose-invert max-w-none mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
      <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
        Feel free to reach out via email, GitHub, LinkedIn, or Google Scholar. I'm open to 
        discussions about research, collaborations, competitive programming, or any technical 
        topics that interest you.
      </p>
    </div>
    
    <div class="space-y-6">
      <div class="flex items-center space-x-4">
        <svg class="w-6 h-6 text-slate-600 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <a href="mailto:jasmer.sanjotra@gmail.com" class="text-lg text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100">
          jasmer.sanjotra@gmail.com
        </a>
      </div>
      
      <div class="flex items-center space-x-4">
        <svg class="w-6 h-6 text-slate-600 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
