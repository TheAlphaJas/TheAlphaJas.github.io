---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperiences } from '../utils/content';

const experiences = getExperiences();
---

<BaseLayout title="Experience | Jasmer's Corner" description="Professional experience in research, engineering, and systems.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold mb-4">Experience</h1>
    
    <div class="prose prose-slate dark:prose-invert max-w-none mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
      <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
        A chronological timeline of my professional experience, including internships, research 
        positions, and other roles. Each entry includes the organization, role, duration, domain 
        of work, key achievements, and technologies used.
      </p>
    </div>
    
    <div class="space-y-12">
      {experiences.map((exp, index) => (
        <div class="relative pl-8 border-l-2 border-slate-200 dark:border-slate-800">
          {index < experiences.length - 1 && (
            <div class="absolute -left-1 top-12 w-2 h-2 bg-slate-300 dark:bg-slate-700 rounded-full"></div>
          )}
          
          <div class="space-y-4">
            <div>
              <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">
                {exp.role}
              </h2>
              <p class="text-lg text-slate-600 dark:text-slate-400">
                {exp.organization}
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-500">
                {exp.duration} • {exp.domain}
              </p>
            </div>
            
            {exp.achievements.length > 0 && (
              <ul class="list-disc list-inside space-y-2 text-slate-700 dark:text-slate-300">
                {exp.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            )}
            
            {exp.techStack.length > 0 && (
              <div>
                <p class="text-sm font-semibold text-slate-600 dark:text-slate-400 mb-2">Tech Stack:</p>
                <div class="flex flex-wrap gap-2">
                  {exp.techStack.map((tech) => (
                    <span class="px-2 py-1 text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded font-mono">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

