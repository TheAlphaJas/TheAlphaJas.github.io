---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

// Read gallery images from public/gallery directory
const galleryDir = path.join(process.cwd(), 'public', 'gallery');
let galleryImages: string[] = [];

if (fs.existsSync(galleryDir)) {
  const files = fs.readdirSync(galleryDir);
  galleryImages = files
    .filter((file) => /\.(jpg|jpeg|png|gif|webp)$/i.test(file))
    .map((file) => `/gallery/${file}`)
    .sort();
}
---

<BaseLayout title="Gallery | Jasmer Singh Sanjotra" description="Photos and visual documentation of experiences, projects, and travels.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="page-header">
      <h1 class="page-title">Gallery</h1>
      <p class="page-subtitle">Photos from research, travel, and the occasional window seat.</p>
    </header>
    
    {galleryImages.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {galleryImages.map((image) => (
          <div class="relative group cursor-pointer overflow-hidden rounded-lg border border-divider hover:border-accent transition-colors">
            <img
              src={image}
              alt="Gallery image"
              class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12 border border-dashed border-divider rounded-lg">
        <p class="text-muted mb-2">No gallery images found.</p>
        <p class="text-sm text-muted">
          Add images to <code class="text-xs bg-subtle px-2 py-1 rounded">public/gallery/</code> to display them here.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

