---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCSESEntries } from '../../../utils/content';
import { renderMarkdown } from '../../../utils/markdown';

export async function getStaticPaths() {
  const entries = getCSESEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const htmlContent = await renderMarkdown(entry.content);
const codeSnippetHtml = entry.codeSnippet
  ? await renderMarkdown(`\`\`\`${entry.language.toLowerCase()}\n${entry.codeSnippet}\n\`\`\``)
  : null;
---

<BaseLayout title={`${entry.problemName} | CSES`} description={`CSES problem: ${entry.problemName}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center gap-4 mb-6">
      <a href="/fun" class="text-muted hover:text-accent inline-flex items-center space-x-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Fun Stuff</span>
      </a>
      <span class="text-muted">/</span>
      <a href="/fun/cses" class="text-muted hover:text-accent">
        CSES
      </a>
    </div>
    
    <article class="prose max-w-none">
      <header class="mb-8 pb-6 border-b border-divider">
        <div class="flex items-center gap-3 mb-2">
          {entry.problemNumber && (
            <span class="text-sm font-mono text-muted">
              #{entry.problemNumber}
            </span>
          )}
          <h1 class="font-serif text-3xl font-medium text-ink mb-0">
            {entry.problemName}
          </h1>
        </div>
        <div class="flex items-center gap-4 text-sm mt-4">
          {entry.difficulty && (
            <span class="px-3 py-1 bg-subtle text-ink rounded">
              {entry.difficulty}
            </span>
          )}
          {entry.language && (
            <span class="text-muted">{entry.language}</span>
          )}
          {entry.github && (
            <a
              href={entry.github}
              target="_blank"
              rel="noopener noreferrer"
              class="link inline-flex items-center gap-1.5 ml-auto"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 .5C5.73.5.98 5.24.98 11.52c0 4.94 3.2 9.14 7.65 10.63.56.1.76-.24.76-.54 0-.27-.01-1.16-.02-2.11-3.11.68-3.77-1.32-3.77-1.32-.51-1.29-1.24-1.64-1.24-1.64-1.01-.69.08-.67.08-.67 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.24.92.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.62 5.24-5.11 5.52.4.35.76 1.03.76 2.08 0 1.5-.01 2.71-.01 3.08 0 .3.2.65.77.54A11.03 11.03 0 0 0 23.02 11.5C23.02 5.24 18.27.5 12 .5Z" />
              </svg>
              <span>View source on GitHub</span>
            </a>
          )}
        </div>
        {entry.keyIdea && (
          <p class="text-muted mt-4 italic">
            <strong>Key Idea:</strong> {entry.keyIdea}
          </p>
        )}
      </header>
      
      {codeSnippetHtml && (
        <div class="mb-8 border-t border-divider pt-6">
          <h2 class="text-xl font-semibold mb-4">Code</h2>
          <div set:html={codeSnippetHtml} />
        </div>
      )}
      
      <div class="border-t border-divider pt-8">
        <div set:html={htmlContent} />
      </div>
    </article>
  </div>
</BaseLayout>

