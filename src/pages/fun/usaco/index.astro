---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getUSACOEntries } from '../../../utils/content';

const entries = getUSACOEntries();
const difficulties = ['Platinum', 'Gold', 'Silver', 'Bronze'];
---

<BaseLayout title="USACO / Competitive Programming | Jasmer's Corner" description="Competitive programming solutions and insights.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/fun" class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 mb-6 inline-flex items-center space-x-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Fun Stuff</span>
    </a>
    
    <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">USACO / Competitive Programming</h1>
    
    <div class="prose prose-slate dark:prose-invert max-w-none mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
      <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-4">
        This section contains my solutions to USACO (USA Computing Olympiad) problems. USACO is one of the 
        premier competitive programming contests in the United States, featuring problems that test algorithmic 
        thinking, data structure knowledge, and problem-solving skills across four difficulty levels: Bronze, 
        Silver, Gold, and Platinum.
      </p>
      <p class="text-slate-700 dark:text-slate-300 leading-relaxed mb-4">
        Each solution includes the complete C++ implementation. The problems are organized by difficulty level, 
        and you can filter by division to find problems at your level. These solutions represent my journey 
        through competitive programming, capturing the key algorithmic insights and implementation techniques 
        required for each problem.
      </p>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        All solutions are available on <a href="https://github.com/TheAlphaJas/USACO-Sols" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">GitHub</a>.
      </p>
      <div class="flex flex-wrap gap-3 mt-4">
        <a
          href="https://leetcode.com/jasmers"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3 py-1.5 text-sm border border-slate-300 dark:border-slate-700 rounded-lg hover:border-slate-900 dark:hover:border-slate-100 transition-colors text-slate-700 dark:text-slate-300"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M16.102 17.93l-2.697 2.607c-.466.467-1.111.662-1.823.662s-1.357-.195-1.824-.662L2.102 13.607c-.467-.467-.702-1.15-.702-1.863s.235-1.357.702-1.824l4.389-4.39c.467-.467 1.15-.702 1.824-.702s1.357.235 1.823.702l.331.331c.195.195.512.195.707 0l2.414-2.414c.195-.195.512-.195.707 0l.331.331c.467.467 1.15.702 1.824.702s1.357-.235 1.823-.702l4.389-4.39c.467-.467 1.15-.702 1.824-.702s1.357.235 1.824.702l2.697 2.607c.467.467.702 1.15.702 1.824s-.235 1.357-.702 1.823l-4.389 4.39c-.467.467-1.15.702-1.824.702s-1.357-.235-1.823-.702l-.331-.331c-.195-.195-.512-.195-.707 0l-2.414 2.414c-.195.195-.512.195-.707 0l-.331-.331c-.467-.467-1.15-.702-1.824-.702s-1.357.235-1.823.702l-4.389 4.39c-.467.467-.702 1.15-.702 1.824s.235 1.357.702 1.823z"/>
          </svg>
          <span>LeetCode</span>
        </a>
        <a
          href="https://codeforces.com/profile/von_Braun"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3 py-1.5 text-sm border border-slate-300 dark:border-slate-700 rounded-lg hover:border-slate-900 dark:hover:border-slate-100 transition-colors text-slate-700 dark:text-slate-300"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.5 7.5C5.328 7.5 6 8.172 6 9v10.5c0 .828-.672 1.5-1.5 1.5h-3C.672 21 0 20.328 0 19.5V9c0-.828.672-1.5 1.5-1.5h3zm9-4.5C14.328 3 15 3.672 15 4.5v15c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5v-15c0-.828.672-1.5 1.5-1.5h3zm9 7.5C23.328 10.5 24 11.172 24 12v7.5c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5V12c0-.828.672-1.5 1.5-1.5h3z"/>
          </svg>
          <span>Codeforces</span>
        </a>
      </div>
    </div>
    
    <!-- Difficulty Filter -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2">
        <button
          data-difficulty="all"
          class="difficulty-filter px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors active"
        >
          All
        </button>
        {difficulties.map((diff) => (
          <button
            data-difficulty={diff}
            class="difficulty-filter px-4 py-2 rounded-lg border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-slate-100 transition-colors"
          >
            {diff}
          </button>
        ))}
      </div>
    </div>
    
    <!-- Entries List -->
    <div class="space-y-4" id="entries-list">
      {entries.map((entry) => (
        <a
          href={`/fun/usaco/${entry.slug}`}
          class="entry-card block p-6 border-2 border-blue-200 dark:border-indigo-700 rounded-lg bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-900 hover:border-blue-400 dark:hover:border-indigo-500 hover:shadow-lg transition-all duration-300 transform hover:scale-105"
          data-difficulty={entry.difficulty}
        >
          <div class="flex justify-between items-start mb-2">
            <div>
              <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">
                {entry.problemName}
              </h2>
              <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
                {entry.contest}
              </p>
            </div>
            <span class="px-3 py-1 text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded">
              {entry.difficulty}
            </span>
          </div>
          <p class="text-slate-700 dark:text-slate-300 mt-3">
            <strong>Key Idea:</strong> {entry.keyIdea}
          </p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const difficultyFilters = document.querySelectorAll('.difficulty-filter');
  const entryCards = document.querySelectorAll('.entry-card');
  
  difficultyFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const selectedDifficulty = filter.getAttribute('data-difficulty');
      
      // Update active state
      difficultyFilters.forEach((f) => f.classList.remove('active', 'border-slate-900', 'dark:border-slate-100'));
      filter.classList.add('active', 'border-slate-900', 'dark:border-slate-100');
      
      // Filter entries
      entryCards.forEach((card) => {
        const difficulty = card.getAttribute('data-difficulty');
        if (selectedDifficulty === 'all' || difficulty === selectedDifficulty) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .difficulty-filter.active {
    @apply border-slate-900 dark:border-slate-100 font-semibold;
  }
</style>

