---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

// Drop a photo at public/img/prof_pic.jpg (or .png/.webp) and it appears here.
const imgDir = path.join(process.cwd(), 'public', 'img');
const profilePic = fs.existsSync(imgDir)
  ? fs
      .readdirSync(imgDir)
      .filter((f) => /^prof_pic\.(jpg|jpeg|png|webp)$/i.test(f))
      .map((f) => `/img/${f}`)[0]
  : undefined;

const news = [
  {
    date: 'Aug 2026',
    text: 'Research on causal reinforcement learning and world models submitted to AAAI 2027.',
  },
  {
    date: 'Jun 2026',
    text: 'Our paper on the reliability of objective metrics for in-the-wild TTS was accepted at INTERSPEECH 2026 (main track).',
  },
  {
    date: 'May 2026',
    text: 'Started as a research intern at IIT Kharagpur, working on causal reinforcement learning and world models.',
  },
];
---

<BaseLayout
  title="Jasmer Singh Sanjotra"
  description="Jasmer Singh Sanjotra — research on causal reinforcement learning, world models, and machine learning for speech and signals."
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-10">
      <h1 class="page-title">Jasmer Singh Sanjotra</h1>
      <p class="page-subtitle">
        Research Intern, IIT Kharagpur &middot; Upcoming Engineer @ Samsung Research Bangalore &middot; B.Tech in Electrical Engineering, IIT Indore
      </p>
    </header>

    <div class="sm:flex sm:gap-10 sm:items-start">
      {
        profilePic && (
          <img
            src={profilePic}
            alt="Jasmer Singh Sanjotra"
            class="w-40 h-40 sm:w-52 sm:h-52 object-cover rounded-md border border-divider mb-8 sm:mb-0 sm:order-2 sm:flex-none"
          />
        )
      }

      <div class="sm:order-1 sm:flex-1 space-y-5 text-ink leading-relaxed">
        <p>
          Hey There. I'm fascinated by a lot of things, and sometimes try to explore them. 
          I have worked on Reinforcement Learning with Causal Inference - trying to investigate how we can improve PPO like policy-gradient methods using causal information.
          Apart from this, I'm also exploring the domain of World Models (Dreamer types and Yann's JEPA - both alike), interesting concepts!
        </p>
        <p>
          Before this I worked mostly on speech and signals — audio-visual speech enhancement,
          evaluation metrics for text-to-speech, machine learning for 6G channel estimation at Samsung,
          and medical image segmentation. I like understanding things from the ground up, and sometimes try (with little discipline nonetheless) to build.
        </p>
        <p>
          Outside research I enjoy competitive programming, solving probability puzzles, and follow
          aviation more closely than is strictly reasonable. Puzzles are fun coz I feel in this age of AI helping us with everything, it's important to give your minds some real juice and keep em warm!
        </p>

        <SocialLinks class="pt-2" />
      </div>
    </div>

    <section class="mt-16 pt-8 border-t border-divider">
      <h2 class="section-title mb-6">News</h2>
      <ul class="space-y-4">
        {
          news.map((item) => (
            <li class="sm:flex sm:gap-6">
              <span class="block text-sm font-mono text-accent sm:w-24 sm:flex-none sm:pt-0.5">{item.date}</span>
              <span class="text-ink">{item.text}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
