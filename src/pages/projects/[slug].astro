---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProject, getProjects } from '../../utils/content';
import { renderMarkdown } from '../../utils/markdown';

export async function getStaticPaths() {
  const projects = getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const htmlContent = await renderMarkdown(project.content);
---

<BaseLayout title={`${project.title} | Jasmer Singh Sanjotra`} description={project.objective}>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/projects" class="text-sm text-muted hover:text-accent transition-colors inline-flex items-center gap-2 mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
      <span>back to projects</span>
    </a>

    <header class="page-header">
      <h1 class="page-title">{project.title}</h1>
      <p class="page-subtitle">{project.objective}</p>
      <div class="flex flex-wrap gap-2 mt-5">
        {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="pill-accent">Code</a>}
        {project.paper && <a href={project.paper} target="_blank" rel="noopener noreferrer" class="pill-accent">Paper</a>}
        {project.tags.map((tag) => <span class="pill">{tag}</span>)}
      </div>
    </header>

    <div class="space-y-8 mb-10">
      <section>
        <h2 class="section-title text-lg mb-3">Tech stack</h2>
        <div class="flex flex-wrap gap-1.5">
          {project.techStack.map((tech) => <span class="pill">{tech}</span>)}
        </div>
      </section>

      {
        project.results && (
          <section>
            <h2 class="section-title text-lg mb-3">Results</h2>
            <p class="text-ink">{project.results}</p>
          </section>
        )
      }

      {
        project.keyIdeas.length > 0 && (
          <section>
            <h2 class="section-title text-lg mb-3">Key ideas</h2>
            <ul class="space-y-1.5 list-disc pl-5 marker:text-accent">
              {project.keyIdeas.map((idea) => (
                <li class="text-ink">{idea}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <article class="prose max-w-none border-t border-divider pt-8">
      <div set:html={htmlContent} />
    </article>
  </div>
</BaseLayout>
