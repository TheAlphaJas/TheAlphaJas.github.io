---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../utils/content';

const projects = getProjects();
const allTags = Array.from(new Set(projects.flatMap((p) => p.tags))).sort();
---

<BaseLayout
  title="Projects | Jasmer Singh Sanjotra"
  description="Research and engineering projects in machine learning, signal processing, and systems."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="page-header">
      <h1 class="page-title">Projects</h1>
      <p class="page-subtitle">Research and engineering work, from papers to things built for the fun of it.</p>
    </header>

    <!-- Tag filter -->
    <div class="flex flex-wrap gap-2 mb-10" id="tag-filters">
      <button data-tag="all" class="tag-filter active">All</button>
      {allTags.map((tag) => <button data-tag={tag} class="tag-filter">{tag}</button>)}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="projects-grid">
      {
        projects.map((project) => (
          <a href={`/projects/${project.slug}`} class="project-card card block p-5" data-tags={project.tags.join(',')}>
            <h2 class="font-serif text-lg text-ink mb-2">{project.title}</h2>
            <p class="text-sm text-muted mb-4">{project.objective}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="pill">{tag}</span>
              ))}
            </div>
            {(project.github || project.paper) && (
              <div class="flex items-center gap-4 mt-4 text-xs text-muted">
                {project.github && <span>code</span>}
                {project.paper && <span>paper</span>}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const tagFilters = document.querySelectorAll<HTMLButtonElement>('.tag-filter');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  tagFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const selectedTag = filter.getAttribute('data-tag');

      tagFilters.forEach((f) => f.classList.remove('active'));
      filter.classList.add('active');

      projectCards.forEach((card) => {
        const tags = card.getAttribute('data-tags')?.split(',') || [];
        card.style.display = selectedTag === 'all' || (selectedTag && tags.includes(selectedTag)) ? 'block' : 'none';
      });
    });
  });
</script>

<style>
  .tag-filter {
    @apply px-3 py-1 text-sm rounded border border-divider text-muted transition-colors;
  }

  .tag-filter:hover {
    @apply text-accent;
    border-color: var(--global-theme-color);
  }

  .tag-filter.active {
    @apply text-accent font-medium;
    border-color: var(--global-theme-color);
  }
</style>
